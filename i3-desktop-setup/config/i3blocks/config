# i3blocks configuration — used by the uConsole bar when the 4G-signal widget
# is enabled (--uconsole-signal). Each block runs a small script on an interval.

separator=true
separator_block_width=16
markup=pango

[modem]
command=~/.config/i3blocks/scripts/4g-signal.sh
interval=10

[wifi]
command=~/.config/i3blocks/scripts/wifi.sh
interval=15

[volume]
command=~/.config/i3blocks/scripts/volume.sh
interval=2
signal=10

[disk]
command=df -h --output=avail / | tail -1 | awk '{print "disk" $1}'
interval=30

[memory]
command=free -h | awk '/^Mem:/ {print "mem " $3 "/" $2}'
interval=10

[load]
command=cut -d' ' -f1 /proc/loadavg | sed 's/^/load /'
interval=10

[battery]
command=~/.config/i3blocks/scripts/battery.sh
interval=20

[time]
command=date '+%Y-%m-%d %H:%M'
interval=5

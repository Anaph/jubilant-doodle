# i3status configuration — managed by i3-desktop-setup.
# Plain-text labels are used so the bar is readable with any installed font.
# See `man i3status` for all modules and format options.

general {
    colors = true
    interval = 5
    color_good     = "#9ece6a"
    color_degraded = "#e0af68"
    color_bad      = "#f7768e"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "disk /"
order += "memory"
order += "load"
order += "tztime local"

wireless _first_ {
    format_up   = "W: %essid (%quality)"
    format_down = "W: down"
}

ethernet _first_ {
    format_up   = "E: %ip"
    format_down = "E: down"
}

disk "/" {
    format = "disk %avail"
}

memory {
    format = "mem %used"
    threshold_degraded = "10%"
    format_degraded = "MEMORY < %available"
}

load {
    format = "load %1min"
}

tztime local {
    format = "%Y-%m-%d %H:%M"
}

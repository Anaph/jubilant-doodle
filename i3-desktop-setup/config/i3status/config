# i3status configuration — the standard, always-readable i3 status bar.
# Bright text on the themed dark bar (colours come from the i3 `bar { colors }`
# block). Plain labels so it's legible with any font. See `man i3status`.

general {
    colors = true
    interval = 5
    color_good     = "#9ece6a"
    color_degraded = "#e0af68"
    color_bad      = "#f7768e"
    separator = "  "
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "disk /"
order += "memory"
order += "load"
order += "tztime local"

wireless _first_ {
    format_up   = "WIFI %essid (%quality)"
    format_down = "WIFI down"
}

# The Huawei HiLink 4G dongle appears as a network interface, so this also
# shows "online via modem" with its IP when connected.
ethernet _first_ {
    format_up   = "NET %ip"
    format_down = "NET down"
}

battery all {
    format = "BAT %status %percentage"
    format_down = ""
    status_chr = "+"
    status_bat = "-"
    status_full = "="
    last_full_capacity = true
    low_threshold = 15
    threshold_type = percentage
    integer_battery_capacity = true
}

disk "/" {
    format = "DISK %avail"
}

memory {
    format = "RAM %used"
    threshold_degraded = "10%"
    format_degraded = "RAM LOW %available"
}

load {
    format = "LOAD %1min"
}

tztime local {
    format = "%a %d %b  %H:%M"
}

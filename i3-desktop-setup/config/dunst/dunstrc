# dunst configuration — managed by i3-desktop-setup.
# Colours follow a Tokyo Night look (the default theme).

[global]
    follow = mouse
    width = 340
    height = 120
    origin = top-right
    offset = 16x16
    notification_limit = 5
    progress_bar = true
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#7aa2f7"
    separator_color = frame
    font = Fira Code 10
    markup = full
    format = "<b>%s</b>\n%b"
    corner_radius = 6
    icon_position = left
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    timeout = 8

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
